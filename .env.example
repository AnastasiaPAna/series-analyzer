# Copy this file to .env and adjust values if needed
DB_HOST=localhost
DB_PORT=5433
DB_NAME=series_db
DB_USER=postgres
DB_PASSWORD=postgres
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
NOTIFICATION_ADMIN_EMAIL=admin@series.local
EMAIL_NOTIFICATION_QUEUE=series-email.notifications
EMAIL_NOTIFICATION_EXCHANGE=series.notifications
EMAIL_NOTIFICATION_ROUTING_KEY=email.notification
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_AUTH=false
EMAIL_SMTP_STARTTLS=false
EMAIL_SMTP_FROM=no-reply@series.local
EMAIL_RETRY_DELAY_MS=300000
